# Скопируйте этот файл в .env и поменяйте значения.

# Логин на Docker Hub — тот же, что при публикации образов.
DOCKERHUB_USER=yourname

# Версия образов. Лучше указывать конкретную версию, а не latest:
# так понятно, что именно запущено, и легко откатиться.
TAG=1.0.0

# 0.0.0.0   — API доступен из интернета по IP сервера;
# 127.0.0.1 — только с самого сервера (если перед API стоит Caddy или nginx).
BIND_ADDR=0.0.0.0

PYTHON_PORT=5000
GO_PORT=5001
